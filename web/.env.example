# Copy to .env.local (git-ignored) and fill in from the Auth0 dashboard. None of these are secrets.
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-spa-client-id
VITE_AUTH0_AUDIENCE=https://api.combpatible.app

# Demo photos only (npm run demo:photos): a free Pexels API key from https://www.pexels.com/api/. A secret: keep it in
# .env.local and never give it a VITE_ prefix, or Vite bundles it into the app.
# PEXELS_API_KEY=
